<odoo>
    <record id="view_print_agent_tree" model="ir.ui.view">
        <field name="name">print.agent.tree</field>
        <field name="model">ll.print.platform.agent</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="active"/>
                <field name="last_seen_at"/>
            </list>
        </field>
    </record>

    <record id="view_print_agent_form" model="ir.ui.view">
        <field name="name">print.agent.form</field>
        <field name="model">ll.print.platform.agent</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="tenant_id"/>
                        <field name="active"/>
                        <field name="api_key" password="True"/>
                        <field name="last_seen_at" readonly="1"/>
                        <field name="allowed_printer_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_print_agent" model="ir.actions.act_window">
        <field name="name">Agents</field>
        <field name="res_model">ll.print.platform.agent</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
