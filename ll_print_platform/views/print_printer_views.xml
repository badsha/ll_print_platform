<odoo>
    <record id="view_print_printer_tree" model="ir.ui.view">
        <field name="name">print.printer.tree</field>
        <field name="model">ll.print.printer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="printer_type"/>
                <field name="agent_identifier"/>
                <field name="tenant_id"/>
                <field name="agent_id"/>
                <field name="default_for_report"/>
                <field name="default_for_invoice"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_print_printer_form" model="ir.ui.view">
        <field name="name">print.printer.form</field>
        <field name="model">ll.print.printer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="printer_type"/>
                        <field name="agent_identifier"/>
                        <field name="tenant_id"/>
                        <field name="agent_id"/>
                        <field name="default_for_report"/>
                        <field name="default_for_invoice"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_print_printer" model="ir.actions.act_window">
        <field name="name">Printers</field>
        <field name="res_model">ll.print.printer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
