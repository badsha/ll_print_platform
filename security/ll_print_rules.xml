<odoo>
    <record id="module_category_ll_print_platform" model="ir.module.category">
        <field name="name">LL Print Platform</field>
        <field name="sequence">60</field>
    </record>

    <record id="privilege_ll_print_platform" model="res.groups.privilege">
        <field name="name">LL Print Platform</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="ll_print_platform.module_category_ll_print_platform"/>
    </record>

    <record id="group_ll_print_manager" model="res.groups">
        <field name="name">LL Print Manager</field>
        <field name="privilege_id" ref="ll_print_platform.privilege_ll_print_platform"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_ll_print_printer_company" model="ir.rule">
        <field name="name">LL Print: Printers multi-company</field>
        <field name="model_id" ref="model_ll_print_printer"/>
        <field name="domain_force">[('tenant_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_ll_print_job_company" model="ir.rule">
        <field name="name">LL Print: Jobs multi-company</field>
        <field name="model_id" ref="model_ll_print_platform_job"/>
        <field name="domain_force">[('tenant_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_ll_print_log_company" model="ir.rule">
        <field name="name">LL Print: Logs multi-company</field>
        <field name="model_id" ref="model_ll_print_platform_log"/>
        <field name="domain_force">[('job_id.tenant_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_ll_print_agent_company" model="ir.rule">
        <field name="name">LL Print: Agents multi-company</field>
        <field name="model_id" ref="model_ll_print_platform_agent"/>
        <field name="domain_force">[('tenant_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
