<odoo>
    <record id="view_ll_print_setup_wizard_form" model="ir.ui.view">
        <field name="name">ll.print.setup.wizard.form</field>
        <field name="model">ll.print.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Printing Setup">
                <sheet>
                    <group>
                        <field name="tenant_id"/>
                    </group>

                    <group string="Step 1: Install Agent">
                        <field name="download_url" readonly="1"/>
                        <button name="action_prepare_agent" type="object" string="Generate / Load API Key" class="btn-primary"/>
                        <button name="action_download_agent" type="object" string="Download Agent" class="btn-secondary"/>
                    </group>

                    <group string="Step 2: Copy API Key">
                        <field name="agent_id" readonly="1" invisible="1"/>
                        <field name="api_key" readonly="1"/>
                        <button name="action_regenerate_api_key" type="object" string="Regenerate" class="btn-secondary" invisible="not agent_id"/>
                    </group>

                    <group string="Step 3: Configure Agent">
                        <field name="odoo_url" readonly="1"/>
                        <field name="agent_config" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ll_print_setup" model="ir.actions.act_window">
        <field name="name">Printing Setup</field>
        <field name="res_model">ll.print.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

    <record id="view_ll_print_platform_direct_print_wizard_form" model="ir.ui.view">
        <field name="name">ll.print.platform.direct.print.wizard.form</field>
        <field name="model">ll.print.platform.direct.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Direct Print">
                <sheet>
                    <group>
                        <field name="tenant_id"/>
                        <field name="report_id"/>
                        <field name="printer_id"/>
                        <field name="res_model" readonly="1"/>
                        <field name="record_ids"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Queue Print" name="action_queue_print" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ll_print_platform_direct_print" model="ir.actions.act_window">
        <field name="name">Direct Print</field>
        <field name="res_model">ll.print.platform.direct.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
